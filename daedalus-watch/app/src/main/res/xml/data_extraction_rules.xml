<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer (round 001, #9). -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Home pilot: press files and pilot settings never leave the watch except to the phone -->
        <exclude domain="file" path="pilot/" />
        <exclude domain="sharedpref" path="pilot.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Home pilot: press files and pilot settings never leave the watch except to the phone -->
        <exclude domain="file" path="pilot/" />
        <exclude domain="sharedpref" path="pilot.xml" />
    </device-transfer>
</data-extraction-rules>
