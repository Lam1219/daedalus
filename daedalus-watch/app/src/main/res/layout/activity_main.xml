<?xml version="1.0" encoding="utf-8"?>
<!-- Watch screens from the Daedalus App Design canvas (450 px design = 225 dp at 2.0x).
     Text is about twice the design's pixel size and every button is at least 48 dp, so they
     stay readable and easy to hit with a tremor.
     Exactly one screen is visible at a time; MainActivity switches them by cue state. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watch_ground">

    <!-- ===== Home: Watch · Ready ===== -->
    <LinearLayout
        android:id="@+id/screen_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextClock
            style="@style/WatchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:letterSpacing="0.02"
            android:textFontWeight="600"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_home_status"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_sage" />

            <TextView
                android:id="@+id/tv_home_status"
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/status_ready"
                android:textColor="@color/watch_sage"
                android:textFontWeight="600"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_stuck"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_circle_sage"
            android:clickable="true"
            android:contentDescription="@string/im_stuck"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_footprints"
                android:tint="@color/watch_ground" />

            <TextView
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:lineSpacingMultiplier="0.95"
                android:maxWidth="92dp"
                android:text="@string/im_stuck"
                android:textColor="@color/watch_ground"
                android:textFontWeight="700"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/cd_heart_rate"
                android:src="@drawable/ic_heart"
                android:tint="@color/watch_sage" />

            <TextView
                android:id="@+id/tv_home_hr"
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/value_none"
                android:textFontWeight="600"
                android:textSize="16sp" />

            <TextView
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="@string/unit_bpm"
                android:textColor="@color/watch_muted"
                android:textSize="12sp" />

            <!-- Breathing rate: hidden until the watch has a value. -->
            <LinearLayout
                android:id="@+id/group_home_breathing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@string/cd_breathing"
                    android:src="@drawable/ic_wind"
                    android:tint="@color/watch_sage" />

                <TextView
                    android:id="@+id/tv_home_breathing"
                    style="@style/WatchText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/value_none"
                    android:textFontWeight="600"
                    android:textSize="16sp" />

                <TextView
                    style="@style/WatchText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/unit_per_min"
                    android:textColor="@color/watch_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Watch · Walking cue ===== -->
    <FrameLayout
        android:id="@+id/screen_walk"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.medicina.daedaluswatch.ui.RingView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_footprints"
                    android:tint="@color/watch_sage" />

                <TextView
                    style="@style/WatchText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/walk_label"
                    android:textColor="@color/watch_sage"
                    android:textFontWeight="600"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_walk_rate"
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:textFontWeight="600"
                android:textSize="44sp" />

            <TextView
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_steps_min"
                android:textColor="@color/watch_muted"
                android:textSize="14sp" />

            <TextView
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxWidth="150dp"
                android:text="@string/hint_step"
                android:textColor="@color/watch_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/btn_walk_stop"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_raised"
                android:clickable="true"
                android:contentDescription="@string/cd_stop"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="124dp"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_stop"
                    android:tint="@color/watch_ink" />

                <TextView
                    style="@style/WatchText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/stop"
                    android:textFontWeight="700"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Watch · Breathing cue ===== -->
    <FrameLayout
        android:id="@+id/screen_breathe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.medicina.daedaluswatch.ui.BreathView
            android:id="@+id/breath"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="30dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wind"
                    android:tint="@color/watch_sage" />

                <TextView
                    style="@style/WatchText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/breathe_label"
                    android:textColor="@color/watch_sage"
                    android:textFontWeight="600"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_breathe_phase"
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="-0.02"
                android:text="@string/breathe_in"
                android:textFontWeight="600"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tv_breathe_rhythm"
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/watch_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_breathe_why"
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="160dp"
                android:textColor="@color/watch_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_breathe_done"
                style="@style/WatchText"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_raised"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="124dp"
                android:paddingHorizontal="18dp"
                android:text="@string/done"
                android:textColor="@color/watch_sage"
                android:textFontWeight="700"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Fine motor / Calm cue (design "Watch · Tremor cue") ===== -->
    <LinearLayout
        android:id="@+id/screen_cue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_surface">

            <ImageView
                android:id="@+id/iv_cue_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_waves"
                android:tint="@color/watch_sage" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_cue_title"
            style="@style/WatchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:maxWidth="160dp"
            android:textFontWeight="600"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_cue_sub"
            style="@style/WatchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxWidth="160dp"
            android:textColor="@color/watch_sage"
            android:textFontWeight="600"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_cue_timer"
            style="@style/WatchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="-0.02"
            android:textFontWeight="600"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_cue_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_raised"
                android:contentDescription="@string/cd_pause"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                android:tint="@color/watch_ink" />

            <ImageButton
                android:id="@+id/btn_cue_stop"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_circle_sage"
                android:contentDescription="@string/cd_stop"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stop"
                android:tint="@color/watch_ground" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
