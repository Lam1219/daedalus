<?xml version="1.0" encoding="utf-8"?>
<!-- Design "Watch · Stand-up prompt". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watch_ground"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_surface">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stand"
            android:tint="@color/watch_sage" />
    </FrameLayout>

    <TextView
        style="@style/WatchText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:lineSpacingMultiplier="0.95"
        android:maxWidth="190dp"
        android:text="@string/stand_title"
        android:textFontWeight="600"
        android:textSize="18sp" />

    <TextView
        style="@style/WatchText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxWidth="176dp"
        android:text="@string/stand_sub"
        android:textColor="@color/watch_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/btn_stand_ready"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_sage"
        android:clickable="true"
        android:contentDescription="@string/stand_ready"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:minWidth="124dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            android:tint="@color/watch_ground" />

        <TextView
            style="@style/WatchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:text="@string/stand_ready"
            android:textColor="@color/watch_ground"
            android:textFontWeight="700"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
