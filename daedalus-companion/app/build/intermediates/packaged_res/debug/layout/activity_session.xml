<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Connection status -->
        <TextView
            android:id="@+id/tv_connection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btn_connect_ble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_connect_ble"
            android:layout_marginBottom="12dp" />

        <!-- HR display -->
        <TextView
            android:id="@+id/tv_hr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hr_display"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Session controls -->
        <TextView
            android:id="@+id/tv_session"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/session_idle"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_start"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_stop"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_export"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btn_labeling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Protocol Labeling"
            android:layout_marginBottom="16dp" />

        <!-- Event markers -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_events"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_rest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_rest" />

        <Button
            android:id="@+id/btn_stress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_stress" />

        <Button
            android:id="@+id/btn_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_sync" />

    </LinearLayout>

</ScrollView>
