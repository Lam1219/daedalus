<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is copied by Google backup or phone-to-phone transfer: the sign-in store's key can't
  move with it (the app would fail to open it) and health data shouldn't leave in a device copy.
  Signed-in data comes back from the account instead (CloudBackup restore).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
