    "cue_auto_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your watch will start these cues by itself when it detects a freeze, a tremor or fast breathing. Until then, start cues from this screen or with “I’m stuck” on your watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre montre lancera ces repères d’elle-même lorsqu’elle détectera un blocage, des tremblements ou une respiration rapide. D’ici là, lancez les repères depuis cet écran ou avec « Je suis bloqué·e » sur votre montre."
          }
        }
      }
    },
