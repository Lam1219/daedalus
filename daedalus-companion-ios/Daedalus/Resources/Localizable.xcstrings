    "data_delete_account_confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account and all your data, on this phone and in your account, will be permanently deleted. You’ll need to create a new account to use Daedalus with an account again. This can’t be undone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte et toutes vos données, sur ce téléphone et dans votre compte, seront supprimés définitivement. Vous devrez créer un nouveau compte pour utiliser Daedalus avec un compte. Cette action est irréversible."
          }
        }
      }
    },
    "data_delete_account_sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes your account, everything saved in it and your data on this phone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime votre compte, tout ce qui y est enregistré et vos données sur ce téléphone."
          }
        }
      }
    },
